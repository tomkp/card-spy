{
  "name": "card-spy",
  "productName": "Card Spy",
  "version": "3.0.0-dev",
  "description": "A smartcard and NFC IDE: APDU workbench, card explorer, scripting and virtual cards",
  "author": "tomkp <tom@tomkp.com>",
  "license": "MIT",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p examples",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "checks": "npm run typecheck && npm run format:check && npm test"
  },
  "dependencies": {
    "smartcard": "^3.7.2"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.1.0",
    "electron-vite": "^6.0.0",
    "monaco-editor": "^0.57.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-split-pane": "3.3",
    "sucrase": "^3.35.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zustand": "^5.0.16"
  },
  "overrides": {
    "dompurify": "^3.4.17"
  }
}
